      "parameters": {
        "baseline_radius_m": 1.2,
        "max_radius_m": 6.0,
        "corroborating_sources": 2
      },
      "trigger": "Path to the target passes within the zone radius, or the robot is inside and not leaving",
      "action": "REPLAN"
    },
    {
      "policy_id": "HAZARD_SLOW_09",
      "name": "Hazard slow zone",
      "description": "Cap speed near a hazard zone. Limits come from reviewed per-hazard rules (0.2 to 0.3 m/s), never from outside text.",
