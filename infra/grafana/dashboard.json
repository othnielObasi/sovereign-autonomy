{
  "dashboard": {
    "title": "Sovereign Autonomy",
    "uid": "sovereign-autonomy",
    "panels": [
      {
        "id": 1,
        "title": "Permits enforced",
        "type": "stat",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 4,
          "h": 4
        },
        "targets": [
          {
            "expr": "permits_enforced",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "title": "Kill switches active",
        "type": "stat",
        "gridPos": {
          "x": 4,
          "y": 0,
          "w": 4,
          "h": 4
        },
        "targets": [
          {
            "expr": "kill_switches_active",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "Permits issued",
        "type": "stat",
        "gridPos": {
          "x": 8,
          "y": 0,
          "w": 4,
          "h": 4
        },
        "targets": [
          {
            "expr": "sum(permits_issued_total)",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Moves refused before a permit",
        "type": "stat",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 4,
          "h": 4
        },
        "targets": [
          {
            "expr": "sum(permits_refused_total)",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "Last kill: revoke / verified stop (ms)",
        "type": "stat",
        "gridPos": {
          "x": 16,
          "y": 0,
          "w": 8,
          "h": 4
        },
        "targets": [
          {
            "expr": "max(kill_revoke_ms_last)",
            "refId": "A"
          },
          {
            "expr": "max(kill_stop_verified_ms_last)",
            "refId": "B"
          }
        ]
      },
      {
        "id": 6,
        "title": "Gate decisions by verdict",
        "type": "timeseries",
        "gridPos": {
          "x": 0,
          "y": 4,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "sum by (decision) (rate(governance_decisions_total[1m]))",
            "refId": "A",
            "legendFormat": "{{decision}}"
          }
        ]
      },
      {
        "id": 7,
        "title": "Permit refusals by reason",
        "type": "timeseries",
        "gridPos": {
          "x": 12,
          "y": 4,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "sum by (reason) (rate(permits_refused_total[1m]))",
            "refId": "A",
            "legendFormat": "{{reason}}"
          }
        ]
      },
      {
        "id": 8,
        "title": "Dispatch outcomes",
        "type": "timeseries",
        "gridPos": {
          "x": 0,
          "y": 12,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "sum by (outcome) (rate(dispatch_total[1m]))",
            "refId": "A",
            "legendFormat": "{{outcome}}"
          }
        ]
      },
      {
        "id": 9,
        "title": "Model calls and p50 latency",
        "type": "timeseries",
        "gridPos": {
          "x": 12,
          "y": 12,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "sum by (model) (model_calls_total)",
